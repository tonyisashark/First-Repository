# kalshi-bot configuration
# Copy to .env and edit. Every value below shows its default; uncomment to change.
# Prices are in CENTS, fractions are of current portfolio equity.

# ---------------------------------------------------------------- credentials
# Create an API key at kalshi.com -> Account -> API Keys (demo keys at
# demo.kalshi.co). Reads and writes both require a key.
KALSHI_API_KEY_ID=
KALSHI_PRIVATE_KEY_PATH=./kalshi-private-key.pem
# or paste the PEM inline instead of a path:
# KALSHI_PRIVATE_KEY=

# --------------------------------------------------------------------- safety
# demo = play-money exchange, prod = real exchange
#KALSHI_ENV=demo
# true = paper trading: real market data, simulated fills, no orders sent
#DRY_RUN=true
# Going live requires ALL THREE: KALSHI_ENV=prod, DRY_RUN=false, and this ack:
#LIVE_TRADING_ACK=
# Paper bankroll (cents)
#PAPER_CASH_CENTS=100000

# ------------------------------------------------------------------ strategies
#STRAT_ARB_ENABLED=true        # mutually-exclusive event arbitrage
#ARB_BUDGET_FRAC=0.30
#STRAT_LONGSHOT_ENABLED=true   # favorite-side harvesting
#LONGSHOT_BUDGET_FRAC=0.40
#STRAT_MM_ENABLED=true         # passive market making
#MM_BUDGET_FRAC=0.20

# ------------------------------------------------------------------------ risk
#MAX_TOTAL_EXPOSURE_FRAC=0.80  # never deploy more than this fraction of equity
#MAX_MARKET_EXPOSURE_FRAC=0.05
#MAX_EVENT_EXPOSURE_FRAC=0.08
#MAX_SERIES_EXPOSURE_FRAC=0.20
#DAILY_LOSS_HALT_FRAC=0.05     # stop entering for the day at -5%
#MAX_DRAWDOWN_HALT_FRAC=0.15   # stop until `kalshi-bot resume` at -15% from peak
#KELLY_FRACTION=0.25
#MIN_ENTRY_PRICE_CENTS=2
#MAX_ENTRY_PRICE_CENTS=98
#MAX_ORDER_CONTRACTS=10000

# ------------------------------------------------------------------- arbitrage
#ARB_MIN_SET_PROFIT_CENTS=0.6  # net of fees, per 1-contract set
#ARB_MIN_TOTAL_PROFIT_CENTS=25
#ARB_DEPTH_SHAVE=0.8           # take only this fraction of visible depth
#ARB_MAX_LEGS=30
#ARB_MAX_COST_FRAC=0.5         # of the arb budget per single opportunity
#ARB_EXHAUSTIVE_BID_FLOOR=0.97
#ARB_REPAIR_SLIPPAGE_CENTS=1

# -------------------------------------------------------------------- longshot
#LONGSHOT_MIN_PRICE_CENTS=90
#LONGSHOT_MAX_PRICE_CENTS=97
#LONGSHOT_EDGE_CENTS=1.0       # assumed favorite underpricing; tune via `calibrate`
#LONGSHOT_MIN_EV_CENTS=0.20
#LONGSHOT_MAX_DAYS_TO_CLOSE=14
#LONGSHOT_MIN_HOURS_TO_CLOSE=1
#LONGSHOT_MIN_VOLUME_24H=100
#LONGSHOT_PER_MARKET_FRAC=0.02
#LONGSHOT_INTERVAL_SECONDS=600

# ---------------------------------------------------------------- market maker
#MM_TOP_N=8
#MM_MIN_VOLUME_24H=2000
#MM_MIN_SPREAD_CENTS=3
#MM_BAND_LOW_CENTS=12
#MM_BAND_HIGH_CENTS=88
#MM_MIN_HOURS_TO_CLOSE=4
#MM_QUOTE_FRAC=0.25
#MM_SKEW_TICKS=2
#MM_REQUOTE_TICKS=1
#MM_POST_ONLY=true

# ---------------------------------------------------------------------- tuning
#POLL_SECONDS=10
#UNIVERSE_REFRESH_SECONDS=120
#UNIVERSE_PAGES_PER_REFRESH=5
#SNAPSHOT_INTERVAL_SECONDS=60
#READ_RPS=8
#WRITE_RPS=4
#TAKER_FEE_BPS=700             # 0.07 * C * P * (1-P), per the fee schedule
#MAKER_FEE_BPS=175
#STATE_DB_PATH=state/kalshi_bot.sqlite3
#LOG_LEVEL=INFO
#CANCEL_ORDERS_ON_EXIT=true
