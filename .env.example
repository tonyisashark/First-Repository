# Copy to `.env` and fill in. Never commit your real .env or private key.

# ---- Environment & credentials -------------------------------------------
# "demo" (paper exchange) or "prod" (real money). Default: demo.
KALSHI_ENV=demo

# API key id (UUID) from Kalshi -> Account -> API Keys.
KALSHI_API_KEY_ID=

# Path to your RSA private key PEM file (downloaded when you created the key).
KALSHI_PRIVATE_KEY_PATH=./kalshi_private_key.pem
# ...or paste the PEM contents inline instead (PATH takes precedence if both set).
KALSHI_PRIVATE_KEY=

# ---- Safety --------------------------------------------------------------
# true  = read live data but place NO real orders (paper trading). DEFAULT.
# false = place REAL orders. Requires valid credentials.
DRY_RUN=true
# Balance (cents) used for sizing while paper-trading without credentials.
PAPER_BALANCE_CENTS=100000

# ---- Markets to monitor --------------------------------------------------
# Comma-separated daily-temperature series tickers. Blank = built-in defaults.
# Verify with: python -m kalshi_temp_bot list-markets --series KXHIGHNY
TEMPERATURE_SERIES=

# ---- Strategy parameters -------------------------------------------------
BUY_YES_PRICE_CENTS=90
SELL_YES_PRICE_CENTS=99
VOLUME_THRESHOLD_RATIO=0.6666666667
PORTFOLIO_FRACTION=0.3333333333
# "global" (one max across everything) or "event" (max volume per city/day)
MAX_VOLUME_SCOPE=global

# ---- Timing --------------------------------------------------------------
POLL_INTERVAL_SECONDS=1.0
SCAN_INTERVAL_SECONDS=5.0
USE_WEBSOCKET=true
FORCE_SELL_BUFFER_SECONDS=60
MIN_SECONDS_TO_CLOSE=300
BUY_TIMEOUT_SECONDS=30

# ---- Advanced ------------------------------------------------------------
# "v2" -> /portfolio/events/orders (current) ; "legacy" -> /portfolio/orders
KALSHI_ORDER_API=v2
# Optional explicit host overrides (otherwise derived from KALSHI_ENV):
KALSHI_API_BASE=
KALSHI_WS_BASE=
